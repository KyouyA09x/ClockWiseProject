<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Material 3 -->
    <style name="Theme.MainActivity" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryContainer">@color/blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/blue_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/blue_primary</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Custom attributes -->
        <item name="backgroundColor">@color/background_light</item>
        <item name="textColorPrimary">@color/on_surface_light</item>
        <item name="textColorSecondary">@color/on_surface_variant_light</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="dividerColor">@color/outline_light</item>
        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <!-- Shape Appearances for Material 3 -->
    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Cyan Theme -->
    <style name="Theme.MainActivity.Cyan" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/cyan_primary</item>
        <item name="colorPrimaryContainer">@color/cyan_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cyan_primary</item>
        <item name="colorSecondaryContainer">@color/cyan_light</item>
        <item name="android:statusBarColor">@color/cyan_primary</item>
        <item name="colorAccent">@color/cyan_primary</item>
    </style>

    <!-- Green Theme -->
    <style name="Theme.MainActivity.Green" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryContainer">@color/green_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorSecondaryContainer">@color/green_light</item>
        <item name="android:statusBarColor">@color/green_primary</item>
        <item name="colorAccent">@color/green_primary</item>
    </style>

    <!-- Purple Theme -->
    <style name="Theme.MainActivity.Purple" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryContainer">@color/purple_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_primary</item>
        <item name="colorSecondaryContainer">@color/purple_light</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
    </style>

    <!-- Orange Theme -->
    <style name="Theme.MainActivity.Orange" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryContainer">@color/orange_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_primary</item>
        <item name="colorSecondaryContainer">@color/orange_light</item>
        <item name="android:statusBarColor">@color/orange_primary</item>
        <item name="colorAccent">@color/orange_primary</item>
    </style>

    <!-- NumberPicker Theme -->
    <style name="NumberPickerTheme" parent="Theme.MainActivity">
        <item name="colorControlNormal">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <!-- Transparent Popup Theme for fullscreen popup notifications -->
    <style name="Theme.Popup.Transparent" parent="Theme.MainActivity">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>