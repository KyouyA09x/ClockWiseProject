<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/floating_menu_background"
        android:elevation="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/floatingMenuTextColor"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal" />

        <!-- Quick Task/Focus Session Option -->
        <LinearLayout
            android:id="@+id/quickTaskCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/menu_item_background"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_flash"
                android:padding="8dp"
                android:background="@drawable/icon_background_cyan"
                android:contentDescription="@string/add_quick_task_focus" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_quick_task_focus"
                android:textSize="16sp"
                android:textColor="?attr/floatingMenuTextColor"
                android:layout_marginStart="14dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/floatingMenuSecondaryTextColor"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- Quick Note Option -->
        <LinearLayout
            android:id="@+id/noteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:background="@drawable/menu_item_background"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notepad"
                android:padding="8dp"
                android:background="@drawable/icon_background_orange"
                android:contentDescription="@string/add_quick_note" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_quick_note"
                android:textSize="16sp"
                android:textColor="?attr/floatingMenuTextColor"
                android:layout_marginStart="14dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/floatingMenuSecondaryTextColor"
                android:contentDescription="@null" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>