<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#20000000"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/menuCard"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header with Back Button -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_back"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    android:contentDescription="Back" />

                <TextView
                    android:id="@+id/menuTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quick Actions"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1C1B1F"
                    android:gravity="center" />

                <!-- Spacer to balance when back button is visible -->
                <View
                    android:id="@+id/headerSpacer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Container for dynamic content -->
            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Main Menu Options -->
                <LinearLayout
                    android:id="@+id/mainMenuContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Quick Task/Focus Session Option -->
                    <LinearLayout
                        android:id="@+id/quickTaskCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/menu_item_background"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_flash"
                            android:padding="8dp"
                            android:background="@drawable/icon_background_cyan"
                            android:contentDescription="Quick Task" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a Quick Task/Focus Session"
                            android:textSize="15sp"
                            android:textColor="#1C1B1F"
                            android:layout_marginStart="14dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <!-- Quick Note Option -->
                    <LinearLayout
                        android:id="@+id/noteCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:background="@drawable/menu_item_background"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_notepad"
                            android:padding="8dp"
                            android:background="@drawable/icon_background_orange"
                            android:contentDescription="Quick Note" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a Quick Note"
                            android:textSize="15sp"
                            android:textColor="#1C1B1F"
                            android:layout_marginStart="14dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Task Type Selection -->
                <LinearLayout
                    android:id="@+id/taskTypeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Quick Task Option -->
                    <LinearLayout
                        android:id="@+id/taskTypeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/menu_item_background"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_reminder"
                            android:padding="8dp"
                            android:background="@drawable/icon_background_green"
                            android:contentDescription="Quick Task" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quick Task"
                            android:textSize="15sp"
                            android:textColor="#1C1B1F"
                            android:layout_marginStart="14dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <!-- Focus Session Option -->
                    <LinearLayout
                        android:id="@+id/focusTypeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:background="@drawable/menu_item_background"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_focus"
                            android:padding="8dp"
                            android:background="@drawable/icon_background_blue"
                            android:contentDescription="Focus Task" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Focus Task"
                            android:textSize="15sp"
                            android:textColor="#1C1B1F"
                            android:layout_marginStart="14dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Quick Task Form -->
                <ScrollView
                    android:id="@+id/quickTaskFormContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Task Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Task Name"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/taskNameLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/design_default_color_primary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/taskNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="What do you need to do?"
                                android:inputType="textCapSentences"
                                android:maxLines="2" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Priority Level -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Priority Level"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <RadioGroup
                            android:id="@+id/taskPriorityGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <RadioButton
                                android:id="@+id/taskPriorityLow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Low"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/taskPriorityMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Medium"
                                android:textSize="13sp"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/taskPriorityHigh"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="High"
                                android:textSize="13sp" />

                        </RadioGroup>

                        <!-- Time -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/taskTimeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:background="@drawable/menu_item_background"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_clock"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/taskTimePreview"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="12:00 PM"
                                android:textSize="15sp"
                                android:textColor="#1C1B1F"
                                android:layout_marginStart="10dp" />

                        </LinearLayout>

                        <!-- Info Text -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="This task is set for today. To change the date, edit it in the app."
                            android:textSize="12sp"
                            android:textColor="#79747E"
                            android:layout_marginBottom="12dp"
                            android:textStyle="italic" />

                        <!-- Notification Settings -->
                        <LinearLayout
                            android:id="@+id/taskNotificationSettings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/taskVibrationSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Vibrate when task is due"
                                android:textSize="14sp"
                                android:checked="false" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/taskAlarmSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sound alarm when task is due"
                                android:textSize="14sp"
                                android:checked="false" />

                        </LinearLayout>

                        <!-- Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/taskCancelButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cancel"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/taskSaveButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save Task" />

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

                <!-- Focus Task Form -->
                <ScrollView
                    android:id="@+id/focusTaskFormContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Focus Task Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Focus Task Name"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/focusNameLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/design_default_color_primary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/focusNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="What will you focus on?"
                                android:inputType="textCapSentences"
                                android:maxLines="2" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Priority Level -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Priority Level"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <RadioGroup
                            android:id="@+id/focusPriorityGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <RadioButton
                                android:id="@+id/focusPriorityLow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Low"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/focusPriorityMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Medium"
                                android:textSize="13sp"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/focusPriorityHigh"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="High"
                                android:textSize="13sp" />

                        </RadioGroup>

                        <!-- Start Time - Compact -->
                        <LinearLayout
                            android:id="@+id/focusStartTimeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:background="@drawable/menu_item_background"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Start Time:"
                                android:textSize="14sp"
                                android:textColor="#49454F" />

                            <TextView
                                android:id="@+id/focusStartTimePreview"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="12:00 PM"
                                android:textSize="15sp"
                                android:textColor="#1C1B1F"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_clock"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <!-- End Time - Compact -->
                        <LinearLayout
                            android:id="@+id/focusEndTimeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:background="@drawable/menu_item_background"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="End Time:"
                                android:textSize="14sp"
                                android:textColor="#49454F" />

                            <TextView
                                android:id="@+id/focusEndTimePreview"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1:00 PM"
                                android:textSize="15sp"
                                android:textColor="#1C1B1F"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_clock"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <!-- Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/focusCancelButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cancel"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/focusSaveButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save Focus Task" />

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

                <!-- Quick Note Form -->
                <ScrollView
                    android:id="@+id/quickNoteFormContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Note Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Note Title"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/noteTitleLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/design_default_color_primary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/noteTitleInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter note title"
                                android:inputType="textCapSentences"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Note Content -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Note Content"
                            android:textSize="14sp"
                            android:textColor="#49454F"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/noteContentLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/design_default_color_primary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/noteContentInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="What's on your mind?"
                                android:inputType="textCapSentences|textMultiLine"
                                android:minLines="3"
                                android:maxLines="5"
                                android:gravity="top" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/noteCancelButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cancel"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/noteSaveButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save Note" />

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </FrameLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
