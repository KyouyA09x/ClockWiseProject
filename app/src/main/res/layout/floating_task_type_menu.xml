<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#20000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/floating_menu_background"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="4dp"
                app:tint="?attr/floatingMenuTextColor"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/choose_type"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/floatingMenuTextColor"
                android:gravity="center" />

            <!-- Close Button -->
            <ImageView
                android:id="@+id/closeButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                app:tint="?attr/floatingMenuTextColor"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Quick Task Option -->
        <LinearLayout
            android:id="@+id/taskTypeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/menu_item_background"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/icon_background_circle" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_reminder"
                    android:padding="8dp"
                    app:tint="@color/white"
                    android:contentDescription="@string/quick_task_header" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quick_task_header"
                android:textSize="16sp"
                android:textColor="?attr/floatingMenuTextColor"
                android:layout_marginStart="14dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/floatingMenuSecondaryTextColor"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- Focus Session Option -->
        <LinearLayout
            android:id="@+id/focusTypeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:background="@drawable/menu_item_background"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/icon_background_circle" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_focus"
                    android:padding="8dp"
                    app:tint="@color/white"
                    android:contentDescription="@string/focus_task_header" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/focus_task_header"
                android:textSize="16sp"
                android:textColor="?attr/floatingMenuTextColor"
                android:layout_marginStart="14dp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/floatingMenuSecondaryTextColor"
                android:contentDescription="@null" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>