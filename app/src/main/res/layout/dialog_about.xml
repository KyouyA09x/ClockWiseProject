<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_lg"
    android:layout_marginVertical="@dimen/spacing_lg"
    android:maxWidth="400dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/dialog_corner_radius"
    app:cardElevation="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Header with Title and Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">
            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="About ClockWise"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:icon="@drawable/ic_close"
                app:iconTint="?attr/colorOnSurface"
                app:iconSize="20dp"
                android:contentDescription="Close" />
        </RelativeLayout>
        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:alpha="0.12" />
        <!-- Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="500dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_lg">
                <!-- About ClockWise Section (Collapsible) -->
                <LinearLayout
                    android:id="@+id/aboutClockwiseSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- App Icon -->
                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:src="@drawable/app_icon"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:contentDescription="ClockWise Icon" />
                    <!-- App Purpose Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Purpose"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Inspired by the concept of time management, the ClockWise application is developed as a potential way to reserve or schedule time to ensure the user is able to do the next coming task or routine."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Features Section Header (Clickable) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/featuresToggleButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Features"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:gravity="center_horizontal"
                        app:icon="@drawable/ic_arrow_down"
                        app:iconTint="?attr/colorPrimary"
                        app:iconGravity="end"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <!-- Features List (Collapsible) -->
                    <LinearLayout
                        android:id="@+id/featuresSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_lg">

                        <TextView
                            android:id="@+id/featureTaskManagement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/feature_task_management"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/featureFocusSessions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/feature_focus_sessions"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/featureCalendarIntegration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/feature_calendar_integration"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/featureNotepad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/feature_notepad"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/featureHistoryTracking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/feature_history_tracking"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/featureReminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/feature_reminders"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:lineSpacingExtra="4dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Meet the Development Team Section -->
                <TextView
                    android:id="@+id/aboutUsToggleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meet the Development Team"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:padding="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <!-- Meet the Development Team Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/aboutUsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/card_padding">

                        <!-- App Icon -->
                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            android:src="@drawable/app_icon"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:contentDescription="ClockWise Icon" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="Development Team"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/about_us_developers"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:lineSpacingExtra="6dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>