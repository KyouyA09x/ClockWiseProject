<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Material 3 Dark -->
    <style name="Theme.MainActivity" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_primary_dark</item>
        <item name="colorPrimaryContainer">@color/blue_dark_variant</item>
        <item name="colorOnPrimary">@color/blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/blue_light</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Surface colors -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <!-- Custom attributes -->
        <item name="backgroundColor">@color/background_dark</item>
        <item name="textColorPrimary">@color/on_surface_dark</item>
        <item name="textColorSecondary">@color/on_surface_variant_dark</item>
        <item name="cardBackgroundColor">@color/dark_card_background</item>
        <item name="dividerColor">@color/outline_dark</item>
        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <!-- Shape Appearances for Material 3 -->
    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Cyan Theme - Dark -->
    <style name="Theme.MainActivity.Cyan" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/cyan_primary_dark</item>
        <item name="colorPrimaryContainer">@color/cyan_dark_variant</item>
        <item name="colorOnPrimary">@color/cyan_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <!-- Green Theme - Dark -->
    <style name="Theme.MainActivity.Green" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/green_primary_dark</item>
        <item name="colorPrimaryContainer">@color/green_dark_variant</item>
        <item name="colorOnPrimary">@color/green_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <!-- Purple Theme - Dark -->
    <style name="Theme.MainActivity.Purple" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/purple_primary_dark</item>
        <item name="colorPrimaryContainer">@color/purple_dark_variant</item>
        <item name="colorOnPrimary">@color/purple_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <!-- Orange Theme - Dark -->
    <style name="Theme.MainActivity.Orange" parent="Theme.MainActivity">
        <item name="colorPrimary">@color/orange_primary_dark</item>
        <item name="colorPrimaryContainer">@color/orange_dark_variant</item>
        <item name="colorOnPrimary">@color/orange_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <!-- NumberPicker Theme - Dark -->
    <style name="NumberPickerTheme" parent="Theme.MainActivity">
        <item name="colorControlNormal">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Bottom Sheet Dialog Theme - Dark -->
    <style name="BottomSheetDialogTheme" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>
</resources>